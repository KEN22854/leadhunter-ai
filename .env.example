# ---------- База данных ----------
DATABASE_URL="file:./dev.db"

# ---------- Авторизация ----------
# Случайная строка не короче 32 символов (npm run setup генерирует её в .env автоматически)
AUTH_SECRET=""
# Тестовый пользователь, которого создаёт сид (только для локальной разработки)
SEED_USER_EMAIL="demo@leadhunter.local"
SEED_USER_PASSWORD="leadhunter-demo-2026"

# ---------- AI (Claude) ----------
# Два способа (AI_PROVIDER=auto выбирает сам):
#  1) Claude Code на этом компьютере — выполните `claude` и войдите в аккаунт: AI работает по вашей подписке, ключ не нужен.
#  2) Anthropic API — ключ с https://console.anthropic.com → API Keys (оплата по токенам).
AI_PROVIDER="auto"            # auto | claude-code | anthropic
ANTHROPIC_API_KEY=""
AI_CLI_MODEL="opus"           # модель для Claude Code: opus | sonnet | haiku
CLAUDE_CLI_PATH=""            # путь к claude, если его нет в PATH
# Модель по умолчанию
AI_MODEL="claude-opus-5-5"
# Лимит AI-запросов на пользователя в минуту
AI_RATE_LIMIT_PER_MIN="12"

# ---------- Email (SMTP) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""                  # например: "Иван Петров <ivan@studio.ru>"

# ---------- Входящая почта (IMAP) — ответы и отказы подтягиваются автоматически ----------
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"
IMAP_POLL_SEC="120"

# ---------- Поиск предприятий (OpenStreetMap) ----------
# Публичные сервисы по умолчанию; для больших объёмов укажите свои инстансы
NOMINATIM_URL=""
OVERPASS_URL=""

# ---------- Прочее ----------
# Папка рабочих проектов клиентов (по умолчанию ./workspace)
WORKSPACE_DIR=""
# 1 — доверять X-Forwarded-For (только если приложение стоит за вашим обратным прокси)
TRUST_PROXY=""
# 1 — не запускать фоновые задачи в этом процессе
DISABLE_SCHEDULER=""

# ---------- Telegram Bot API ----------
# Бот может писать только тем, кто сам начал с ним диалог (/start)
TELEGRAM_BOT_TOKEN=""

# ---------- WhatsApp Business Platform (Cloud API) ----------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Одобренный Meta шаблон для первого сообщения вне 24-часового окна
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="ru"

# ---------- Модуль «Спрос»: официальные API площадок (все необязательны) ----------
# Без ключей работают открытые источники: FL.ru, Kwork, Freelancer.com, Dribbble, Product Hunt,
# VC.ru, Хабр, Hacker News, публичные Telegram-каналы, свои RSS-ленты.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
VK_ACCESS_TOKEN=""
X_BEARER_TOKEN=""
THREADS_ACCESS_TOKEN=""
# Ответы в Threads через API: свой лимит приложения (по умолчанию 20 в сутки) и пауза между ответами, мин (по умолчанию 5)
THREADS_DAILY_REPLY_LIMIT=""
THREADS_REPLY_INTERVAL_MIN=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
DISCORD_BOT_TOKEN=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
YANDEX_SEARCH_API_KEY=""
YANDEX_FOLDER_ID=""
GOOGLE_PLACES_API_KEY=""
YANDEX_MAPS_API_KEY=""
DGIS_API_KEY=""
CRUNCHBASE_API_KEY=""
