// LEADHUNTER AI — схема данных.
// SQLite для локальной разработки; перечисления хранятся строками (значения — в src/lib/domain.ts).
// Поля Json хранят структурированные данные (факторы, находки, блоки КП).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("manager") // manager | admin
  createdAt    DateTime @default(now())

  profile         ExecutorProfile?
  clients         Client[]
  templates       MessageTemplate[]
  suppression     SuppressionEntry[]
  tasks           ClientTask[]       @relation("TaskAssignee")
  usage           AIUsageLog[]
  audit           AuditLog[]
  searches        LeadSearch[]
  campaigns       Campaign[]
  signalCampaigns SignalCampaign[]
  socialLeads     SocialLead[]
}

// Профиль исполнителя: «допустимые факты», которые ИИ может использовать о пользователе
model ExecutorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String   @default("")
  companyName    String   @default("")
  description    String   @default("")
  specialization String   @default("")
  advantages     String   @default("")
  portfolioUrl   String   @default("")
  website        String   @default("")
  signature      String   @default("")
  cases          String   @default("") // свободный текст: кейсы, которые разрешено упоминать
  pricingNotes   String   @default("") // цены/условия, введённые пользователем
  requisites     String   @default("") // реквизиты для КП
  updatedAt      DateTime @updatedAt
}

model Client {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyName    String
  description    String    @default("")
  category       String    @default("")
  industry       String    @default("")
  country        String    @default("")
  region         String    @default("")
  city           String    @default("")
  website        String    @default("")
  logoUrl        String    @default("")
  language       String    @default("ru")
  status         String    @default("new")
  priority       String    @default("medium")
  archived       Boolean   @default(false)
  doNotContact   Boolean   @default(false)
  firstSeenAt    DateTime  @default(now())
  lastCheckedAt  DateTime?
  externalId     String    @default("") // источник импорта, напр. osm:node/123 — защита от дублей
  siteAudit      Json? // результат автоматического аудита сайта (что улучшить)
  siteAuditScore Int?
  siteAuditAt    DateTime?
  workspacePath  String    @default("") // рабочая папка проекта после согласия клиента
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  references    Reference[]
  campaignItems CampaignItem[]
  contacts      Contact[]
  sources       LeadSource[]
  provenance    FieldProvenance[]
  analyses      LeadAnalysis[]
  scores        LeadScore[]
  messages      AIMessage[]
  conversations Conversation[]
  interactions  Interaction[]
  tasks         ClientTask[]
  deals         Deal[]
  proposals     Proposal[]
  consents      ConsentRecord[]
  copilot       CopilotMessage[]
  usage         AIUsageLog[]

  @@index([ownerId, archived])
  @@index([ownerId, externalId])
}

model Contact {
  id                 String      @id @default(cuid())
  clientId           String
  client             Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type               String // email | phone | website | telegram | whatsapp | linkedin | social | other
  value              String
  normalizedValue    String
  label              String      @default("")
  sourceId           String?
  source             LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  verificationStatus String      @default("found") // found | formal | confirmed | invalid | unknown
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  discoveredAt       DateTime    @default(now())
  doNotContact       Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  conversations Conversation[]
  consents      ConsentRecord[]
  messages      AIMessage[]

  @@index([clientId])
  @@index([normalizedValue])
}

model LeadSource {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceType   String // website | directory | marketplace | job_post | social | manual | other
  sourceUrl    String    @default("")
  title        String    @default("")
  method       String    @default("manual") // manual | fetch | import
  capturedAt   DateTime  @default(now())
  checkedAt    DateTime?
  rawReference String    @default("") // краткая выдержка/текст страницы (обрезанный)
  evidence     String    @default("") // какие утверждения подтверждает источник
  createdAt    DateTime  @default(now())

  contacts   Contact[]
  provenance FieldProvenance[]

  @@index([clientId])
}

// Происхождение значений полей; несколько записей на одно поле = возможный конфликт
model FieldProvenance {
  id         String      @id @default(cuid())
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field      String
  value      String
  sourceId   String?
  source     LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  capturedAt DateTime    @default(now())
  selected   Boolean     @default(false)

  @@index([clientId, field])
}

model LeadAnalysis {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  summary         String
  findings        Json // структурированный отчёт
  recommendations Json
  risks           Json
  sources         Json
  confidence      String   @default("low")
  model           String
  promptVersion   String
  pagesAnalyzed   Json
  createdAt       DateTime @default(now())

  @@index([clientId, createdAt])
}

model LeadScore {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  score        Int
  factors      Json
  explanation  String
  calculatedAt DateTime @default(now())

  @@index([clientId, calculatedAt])
}

model AIMessage {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  generationId    String // объединяет три варианта одной генерации
  variantKey      String // recommended | short | expert | manual
  label           String   @default("")
  channel         String
  language        String
  tone            String
  goal            String
  service         String
  length          String
  instructions    String   @default("")
  subject         String   @default("")
  body            String
  personalization Json
  assumptions     Json
  warnings        Json
  evidence        Json? // { serviceRationale, toVerify[] } — блок «Почему ИИ составил именно это сообщение?»
  status          String   @default("draft") // draft | saved | queued | sent | archived
  version         Int      @default(1)
  model           String   @default("")
  promptVersion   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions AIMessageVersion[]

  @@index([clientId, createdAt])
}

model AIMessageVersion {
  id        String    @id @default(cuid())
  messageId String
  message   AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  version   Int
  subject   String    @default("")
  body      String
  origin    String // generated | edited | rewrite | restore
  note      String    @default("")
  createdAt DateTime  @default(now())

  @@unique([messageId, version])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  category  String   @default("")
  channel   String
  language  String   @default("ru")
  subject   String   @default("")
  content   String
  variables Json
  createdAt DateTime @default(now())
}

model Conversation {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel          String
  externalThreadId String    @default("") // email: адрес; telegram: chat_id; whatsapp: номер
  connectionId     String    @default("")
  status           String    @default("open")
  lastInboundAt    DateTime?
  createdAt        DateTime  @default(now())

  items ConversationMessage[]

  @@index([clientId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // outbound | inbound
  aiMessageId    String?
  subject        String       @default("")
  body           String
  status         String       @default("draft") // draft | pending_approval | sending | sent | delivered | failed | replied | received
  error          String       @default("")
  externalId     String       @default("")
  idempotencyKey String?      @unique
  approvedAt     DateTime?
  approvedById   String?
  attachments    Json? // [{ kind: "reference_pdf" | "reference_html", referenceId }]
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Interaction {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  actorId    String?
  actorLabel String   @default("system")
  summary    String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientTask {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  dueAt       DateTime?
  priority    String    @default("medium")
  status      String    @default("new") // new | in_progress | done | cancelled
  kind        String    @default("task") // task | follow_up | meeting | call
  source      String    @default("manual") // manual | ai
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
}

model Deal {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  stage           String    @default("qualification")
  amount          Float?
  currency        String    @default("RUB")
  probability     Int?
  expectedCloseAt DateTime?
  createdAt       DateTime  @default(now())
}

model Proposal {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  service   String   @default("")
  content   Json // { blocks: [{ key, title, body }] }
  status    String   @default("draft") // draft | ready | sent | accepted | rejected
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ProposalVersion[]
}

model ProposalVersion {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version    Int
  title      String
  content    Json
  createdAt  DateTime @default(now())

  @@unique([proposalId, version])
}

model ConsentRecord {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  basis        String // consent | published_request | legitimate_interest | existing_relationship
  note         String    @default("")
  sourceUrl    String    @default("") // где опубликован контакт/запрос (для законного интереса)
  recordedById String
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String    @default("")
  createdAt    DateTime  @default(now())
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  value     String // нормализованный email/телефон/домен/username
  type      String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([ownerId, value])
}

model CopilotMessage {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model AIUsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  operation    String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costEstimate Float    @default(0)
  status       String // ok | error | refused | not_configured
  error        String   @default("")
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())
}

// ---------- Поиск предприятий (OpenStreetMap) ----------
model LeadSearch {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category      String // ключ категории из src/lib/discovery/categories.ts или custom
  categoryLabel String
  osmFilter     String // напр. ["amenity"="cafe"]
  country       String
  city          String
  status        String    @default("running") // running | done | failed
  scope         String    @default("city") // city | country | world
  limitN        Int       @default(0) // 0 = без ограничения (до лимита честного использования источника)
  fetched       Int       @default(0)
  stopRequested Boolean   @default(false)
  heartbeatAt   DateTime?
  total         Int       @default(0)
  error         String    @default("")
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  results SearchResult[]

  @@index([ownerId, createdAt])
}

model SearchResult {
  id           String     @id @default(cuid())
  searchId     String
  search       LeadSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  ownerId      String
  externalId   String // osm:node/123
  name         String
  category     String     @default("")
  address      String     @default("")
  city         String     @default("")
  country      String     @default("")
  lat          Float?
  lon          Float?
  website      String     @default("")
  phone        String     @default("")
  hasSocial    Boolean    @default(false) // в OSM указаны соцсети/мессенджеры
  emails       Json? // [{ email, source, url }]
  enrichStatus String     @default("pending") // pending | running | done | no_site | failed
  enrichError  String     @default("")
  audit        Json?
  auditScore   Int?
  enrichedAt   DateTime?
  clientId     String? // если добавлен в CRM
  rank         Int        @default(0) // популярность + известность + возможность написать (0–100)
  rankNote     String     @default("")
  importance   Float?
  hasEmail     Boolean    @default(false)
  hasWebsite   Boolean    @default(false)
  opportunity  String     @default("") // high | medium | low (после аудита)
  createdAt    DateTime   @default(now())

  @@unique([searchId, externalId])
  @@index([ownerId, enrichStatus])
  @@index([searchId, rank])
  @@index([enrichStatus, rank])
}

// ---------- Референс: концепция улучшений + HTML-прототип ----------
model Reference {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String   @default("")
  concept       Json // структура концепции (см. ReferenceConceptSchema)
  html          String   @default("") // самодостаточный HTML-прототип (без скриптов)
  emailSubject  String   @default("")
  emailBody     String   @default("")
  model         String   @default("")
  promptVersion String   @default("")
  status        String   @default("draft") // draft | approved
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, createdAt])
}

// ---------- Кампании: одобренная пачка писем, отправляемых автоматически с лимитами ----------
model Campaign {
  id             String    @id @default(cuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  status         String    @default("draft") // draft | running | paused | done
  attachPdf      Boolean   @default(true)
  attachHtml     Boolean   @default(false)
  dailyLimit     Int       @default(25)
  intervalMin    Int       @default(4)
  windowStart    Int       @default(9) // часы локального времени сервера
  windowEnd      Int       @default(19)
  basisConfirmed Boolean   @default(false)
  approvedAt     DateTime?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items CampaignItem[]

  @@index([ownerId, status])
}

model CampaignItem {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId   String?
  referenceId String?
  subject     String    @default("")
  body        String    @default("")
  status      String    @default("draft") // draft | ready | sending | sent | failed | skipped | replied | opted_out
  error       String    @default("")
  outboundId  String? // ConversationMessage.id
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([campaignId, clientId])
  @@index([status])
}

// Служебное состояние фоновых задач (офсет Telegram, UID IMAP и т.п.)
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ================= МОДУЛЬ 2: поиск спроса в соцсетях, на биржах и в сообществах =================

// Поисковая кампания: что ищем, где и как часто
model SignalCampaign {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  service      String // ключ из src/lib/signals/services.ts
  country      String    @default("")
  city         String    @default("")
  languages    Json // ["ru","en"]
  sources      Json // ["fl_ru","freelancer",...]
  keywords     Json // дополнительные ключевые фразы пользователя
  excludeWords Json? // стоп-слова
  businessType String    @default("")
  orderType    String    @default("any") // any | one_time | ongoing | launch
  periodDays   Int       @default(14)
  maxResults   Int       @default(100)
  minScore     Int       @default(40)
  schedule     String    @default("once") // once | daily | weekly
  feeds        Json? // пользовательские RSS-ленты сообществ
  channels     Json? // публичные Telegram-каналы, сабреддиты, сообщества VK
  useAI        Boolean   @default(true)
  status       String    @default("active") // active | paused
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  runs    SignalRun[]
  signals LeadSignal[]

  @@index([ownerId, status])
  @@index([status, nextRunAt])
}

model SignalRun {
  id         String         @id @default(cuid())
  campaignId String
  campaign   SignalCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  trigger    String         @default("manual") // manual | schedule | retry
  status     String         @default("running") // running | done | partial | failed
  stats      Json? // по источникам: { fetched, matched, saved, error, skipped }
  fetched    Int            @default(0)
  matched    Int            @default(0)
  saved      Int            @default(0)
  newLeads   Int            @default(0)
  error      String         @default("")
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  @@index([campaignId, startedAt])
}

// Человек или компания, проявившие спрос. Объединяет все найденные публикации и идентификаторы.
model SocialLead {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName      String
  headline         String    @default("") // сфера деятельности / описание профиля, если публично
  profileUrl       String    @default("")
  primarySource    String
  country          String    @default("")
  city             String    @default("")
  language         String    @default("")
  service          String    @default("")
  intent           String    @default("unknown")
  temperature      String    @default("potential") // hot | warm | potential | cold
  score            Int       @default(0)
  scoreFactors     Json?
  scoreExplanation String    @default("")
  status           String    @default("new") // new | qualified | contacted | replied | positive | declined | converted | archived
  doNotContact     Boolean   @default(false)
  clientId         String? // карточка в CRM после конвертации
  notes            String    @default("")
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  firstContactAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  signals    LeadSignal[]
  identities LeadIdentity[]
  drafts     OutreachDraft[]
  attempts   OutreachAttempt[]

  @@index([ownerId, temperature, score])
  @@index([ownerId, status])
}

// Ключи дедупликации: профиль, домен, email, телефон, id источника
model LeadIdentity {
  id        String     @id @default(cuid())
  ownerId   String
  leadId    String
  lead      SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String // profile | domain | email | phone | source_id
  value     String // нормализованное значение
  source    String     @default("")
  createdAt DateTime   @default(now())

  @@unique([ownerId, kind, value])
  @@index([leadId])
}

// Публикация (пост, заказ, комментарий), в которой обнаружен спрос
model LeadSignal {
  id            String          @id @default(cuid())
  ownerId       String
  leadId        String
  lead          SocialLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      SignalCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  runId         String?
  source        String
  externalId    String
  url           String
  title         String          @default("")
  text          String
  authorName    String          @default("")
  authorUrl     String          @default("")
  publishedAt   DateTime?
  language      String          @default("")
  budget        String          @default("")
  matchedTerms  Json?
  intent        String          @default("unknown")
  intentScore   Int             @default(0)
  intentReasons Json?
  aiIntent      Json? // результат AI-классификации (если выполнялась)
  serviceMatch  Int             @default(0)
  score         Int             @default(0)
  scoreFactors  Json?
  temperature   String          @default("potential")
  createdAt     DateTime        @default(now())

  @@unique([ownerId, source, externalId])
  @@index([leadId])
  @@index([campaignId, createdAt])
}

// Подготовленные персональные обращения (3 варианта + ручные правки)
model OutreachDraft {
  id            String     @id @default(cuid())
  leadId        String
  lead          SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  signalId      String?
  generationId  String
  variant       String // friendly | business | short | manual
  language      String
  subject       String     @default("")
  body          String
  evidence      Json? // на какие факты публикации опирается сообщение
  warnings      Json?
  origin        String     @default("ai") // ai | template | edited | rewrite
  model         String     @default("")
  promptVersion String     @default("")
  status        String     @default("draft") // draft | saved | used | archived
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([leadId, createdAt])
}

// Попытка коммуникации. Статусы — только подтверждённые факты:
// prepared → opened (открыт исходный диалог) → confirmed_sent (пользователь подтвердил ручную отправку)
// | sent (отправлено через официальный канал) | failed | cancelled. Ответ — в outcome.
model OutreachAttempt {
  id             String     @id @default(cuid())
  leadId         String
  lead           SocialLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  draftId        String?
  signalId       String?
  mode           String // api | open_dialog | platform_reply
  channel        String // email | reddit | telegram | fl_ru ...
  target         String     @default("") // URL диалога/публикации или адрес
  subject        String     @default("")
  body           String
  status         String     @default("prepared")
  outcome        String     @default("none") // none | replied | positive | negative | no_response
  error          String     @default("")
  outboundId     String? // ConversationMessage.id при отправке через CRM
  idempotencyKey String?    @unique
  preparedAt     DateTime   @default(now())
  openedAt       DateTime?
  sentAt         DateTime?
  repliedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([leadId])
  @@index([status])
}

// Журнал оснований обработки персональных данных (сохраняется после удаления лида)
model ProcessingLog {
  id        String   @id @default(cuid())
  ownerId   String
  leadId    String? // без внешнего ключа: запись переживает удаление лида
  subject   String // кого касается (после удаления — обезличено)
  action    String // collected | merged | contacted | converted | opted_out | deleted
  basis     String // published_request | legitimate_interest | consent | user_request
  sourceUrl String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([leadId])
}

// Состояние источника: ошибки, лимиты, бэкофф
model SourceState {
  source           String    @id
  lastRequestAt    DateTime?
  lastOkAt         DateTime?
  lastErrorAt      DateTime?
  lastError        String    @default("")
  consecutiveFails Int       @default(0)
  backoffUntil     DateTime?
  requestsToday    Int       @default(0)
  dayKey           String    @default("")
  updatedAt        DateTime  @updatedAt
}
